<!DOCTYPE html>
<html>
<head>
    <title>Image Map Example</title>
</head>
<body>

<h2>Image Map Example (Clickable Regions)</h2>

<img src="map.png" usemap="#myMap" width="500" height="350">
<map name="myMap">
    <area shape="rect" coords="40,40,220,140" href="page1.html" alt="Rectangle">
    <area shape="circle" coords="350,210,60" href="page2.html" alt="Circle">
</map>

</body>
</html>


